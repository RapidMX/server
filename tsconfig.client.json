{
    "extends": "@rapidrest/react/tsconfig/client",
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "dist",
        "sourceMap": false,
        "declaration": false,
        // `@dnd-kit/core`'s own .d.ts files reference the pre-React-19 global `JSX` namespace (removed
        // now that `@types/react`/React 19 moved it to `React.JSX`) — this only affects re-checking
        // that *library's own* declaration files, not how this project's code that imports from it is
        // type-checked, so it's safe to skip rather than a real risk.
        "skipLibCheck": true
    },
    "include": ["apps"]
}
